<TcPlcObject Version="1.1.0.1">
  <GVL Name="IO_Axes_codeurs" Id="{c4d40f69-06ee-42ac-b119-a4bc42869b6e}">
    <Declaration><![CDATA[{attribute 'Tc2GvlVarNames'}
VAR_GLOBAL

(****************************** Variables NC pour La Tache Interpreteur ISO ******************************)
	XYL_NciChannelToplc						AT %I*:	NCTOPLC_NCICHANNEL_REF;		(*Pour lecture etat Canal exec ISO X/Y Laser*)
	XYL_NciChannelFromPlc					AT %Q*:	PLCTONC_NCICHANNEL_REF;		(*Pour lecture etat Canal exec ISO X/Y Laser*)
	ItpWriteToolDesc1:ItpWriteToolDescex;
	Parametre_Outil: ToolDesc;

	Axe_0	:AXIS_REF;	(*Axe bidon mais nécessaire car il est obligatoire de lier un axe maître en entrée de chaque FB_axe*)

(****************************** Variables Axe1---X Chariot ******************************)
	Axe_1	:AXIS_REF;

(****************************** Variables Axe2---Z Chariot ******************************)
	Axe_2	:AXIS_REF;

(****************************** Variables Axe40---X Laser ******************************)
	Axe_40	:AXIS_REF;

(****************************** Variables Axe41---Y Laser ******************************)
	Axe_41	:AXIS_REF;

(****************************** Variables Axe42---Z Laser******************************)
	Axe_42	:AXIS_REF;

(****************************** Variables Axe43---A Rotation Angulaire ******************************)
	Axe_43	:AXIS_REF;

	
END_VAR
]]></Declaration>
  </GVL>
