<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="_Divers_lifter_VB" Id="{b9f1caf5-6bd8-4dc6-a3ff-74b2510711ca}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM _Divers_lifter_VB
VAR	RE_Fin_programme:R_TRIG;	
	FE_Laser_Start:F_TRIG;
	FE_Top_deg_torche_VB_full, FE_Top_deg_torche_VB_partiel: F_trig;
	nbr_echantillon, i, nbr_U_cumul: INT;
	echantillon : ARRAY[1..100] OF LREAL;
	FE_Breakaway_Plasma_ok: F_trig;
	Ep_retract_partiel_torche_temp: LREAL;
	TON_NOT_Kjellberg_contact_ohmique:TON;
	blocage_torche_grande_variation_tension_scope: BOOL;
	id_Dist_max, id_Dist_min : INT;
	step_top_torche: int;
	TON_Bug_top_torche: Ton;
	FE_TOF_Laser_Start: F_trig;
	TOF_Laser_Start: TOF;
	Step_control_geometrie_plasma: INT;
	TON_Case_102, TON_Case_105: Ton;
	RE_Top_cycle_controle_geometrie_torche : R_trig;
	TON_Start_axe: Ton;
	TON_blocage_asserv_GdeVari_Capa: TON;
	time_autoKerf:TIME:=T#12MS;
	ecart_u_arc:LREAL;
	Rdy_to_retract : bool;
	RE_Rdy_to_retract: R_trig;
	RE_autokerf: R_trig;
	FE_autokerf: F_trig;
	Memo_Dist_ap_autokerf: INT;
	Memo_Dist_av_autokerf: INT;
	inhib_autokerf: BOOL;
	TP_inhib_autokerf: TP;
	FE_inhib_autokerf: f_trig;
	Largeur_pont_Chain_Cut: LREAL;
	memo_Fin_decoupe: bool := false;
	memo_contact_torche_tole: BOOL;
	TON_contact_torche_tole: Ton;
	TON_anti_scintillement_collision_Laser: Ton;
	RE_Lifter_VB_ok_pour_decoupe: R_trig;
	RE_Start_ISO_5D: R_trig;
	RE_Asser	:R_TRIG;
	
	TON_ActivAsserv	:TON;	//On laisse le temps a l'axe de faire l'asservissement - Oui 2s c'est enorme, non ca ne met pas autant de temps
		Ecart_Max	:LREAL:=0.1;
		R_Memo_Z	:R_TRIG;
	Memo_Z_autokerf	:LREAL;	//Memorise la pos Z pour bloquer l'asserv si trop gde variation
	Memo_DistBuse_autokerf	:LREAL;
	
	F_Iso	:F_TRIG;
	
// pour calcul position sommet théorique	
	F1X1,	F1Y1,
	F1X2,	F1Y2,
	F2X1,	F2Y1,
	F2X2,	F2Y2	:LREAL;
	a1s: LREAL;
	b1s: LREAL;
	a2s: LREAL;
	b2s: LREAL;
	Alpha1s: LREAL;
	Alpha2s: LREAL;
	Y_Sommet_Pour_Aile_OPP_REF_TH: LREAL;
	Y_Sommet_Pour_Aile_REF_TH: LREAL;
	
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*********************** Front et tempo **********************)
	FE_Laser_Start(clk:= Tir_Laser); //tempo Pour attendre FE_jog avant de demander un retract
	FE_TOF_Laser_Start(clk:= TOF_Laser_Start.Q);
	TOF_Laser_Start(in:=Tir_Laser,PT:=T#0.5S);
	FE_Top_deg_torche_VB_full(clk:=Top_deg_Laser_full);
	FE_Top_deg_torche_VB_partiel(clk:=Top_deg_Laser_partiel);
	RE_Fin_programme(clk:=Sequence[Pt_sequence].M=0);	
	F_Iso(clk:=ISO_en_cours);

(*********************** Blocage torche si variation de capacitance (Hors Traj avec M10) **********************) // a investiguer, quid si variation ? blocage torche ou défaut ? + adapter pour capacitance 
	 TON_ActivAsserv(in:=Axe_42_Z_Laser.ZLaser.asserv AND NOT F_M10, pt:=T#1S);	//On detecte l'asserv, estimation du temps de mise en place ?
			
	 R_Memo_Z(Clk:=TON_ActivAsserv.Q);	//Asserv etabli, que vaut Z ?
	 IF R_Memo_Z.Q THEN
		 Memo_Z_autokerf:=Pos_Reel_Z_Laser+0.1;	//Pour etre sur que c'est l'asserv qui fait depasser la valeur et pas une oscillation
		 Memo_DistBuse_autokerf:=Prog_Capacitance_Actual_Value_mm;
	 END_IF
	 
	TON_blocage_asserv_GdeVari_Capa(		
		in:= Memo_Z_autokerf <>0 
			AND (Pos_Reel_Z_Laser>Memo_Z_autokerf)	//La buse est plus avancee qu'au debut
			AND	((Prog_Capacitance_Actual_Value_mm-Memo_DistBuse_autokerf)>=Ecart_Max),	//Un ecart important est constate - A investiguer : Valeur capa bouge pendant tir ? 
		PT := time_autoKerf);										//Mesure de l'ecart entre buse et piece pour detecter un trou ou brod de corniere - Si la torche s'avance trop
		
	inhib_autokerf:= NOT TON_ActivAsserv.Q OR F_M10;	//On desactive la fonction autokerf si asserv pas encore etablit ou si demande de l ISO -Pour ne pas avoir de conflit- 
	
 	IF NOT TON_ActivAsserv.Q THEN 	//Raz du memo si pas d'asserv
		Memo_Z_autokerf:=0;
	END_IF
	
	blocage_asserv_gde_variation := TON_blocage_asserv_GdeVari_Capa.Q AND NOT inhib_autokerf; 
	TON_Gde_Variation_Capa(in:=blocage_asserv_gde_variation,PT:=T#2S);  		
	IF blocage_asserv_gde_variation THEN Def_Gde_Variation_Capa:=TRUE; END_IF

(************************* Blocage torche pour grande vitesse ************************)
	IF Pnc_decoupe[4] >= 6000 THEN
		blocage_torche_grande_vitesse := TRUE;
	ELSE
		blocage_torche_grande_vitesse := FALSE;
	END_IF

(****************************** Dégagement partiel de la torche (Z)******************************)
	IF FE_Laser_Start.Q THEN
		memo_Fin_decoupe := TRUE;
	END_IF
	
	IF (memo_Fin_decoupe OR Top_deg_Laser_partiel)
	AND G7_Cycle_Percages_Laser.Init.x 
	AND NOT Z_Laser_en_mode_esclave 
	AND No_Move_Z_Laser 
	AND Status_Fb_exec_ISO_3D_init
	THEN	
	
		memo_Fin_decoupe := FALSE;
		
		full_retract_torche := Ep_retract_partiel_torche=0;
		
		IF Ep_retract_partiel_torche=0 THEN
			Ep_retract_partiel_torche_temp :=0;
		ELSIF Ep_secu < Ep_retract_partiel_torche THEN
			Ep_retract_partiel_torche_temp := pos_ref_torche-Ep_retract_partiel_torche ;
		ELSE 
			Ep_retract_partiel_torche_temp := pos_ref_torche-Ep_secu ;
		END_IF 	
		
		IF Ep_retract_partiel_torche_temp < Pnc_axe_Z_Robot.Limite_Moins THEN
			Pos_cible_Z_Laser:= Ep_retract_partiel_torche_temp ;
		ELSE 	
			Pos_cible_Z_Laser:= Ep_retract_partiel_torche_temp ;
		END_IF
		
		IF Retract_speed > Pnc_axe_Z_Robot.Vitesse_PTP THEN
			Vitesse_Z_Laser_PTP:= Pnc_axe_Z_Robot.Vitesse_PTP;
		ELSE
			Vitesse_Z_Laser_PTP := Retract_speed;
		END_IF
		Top_Z_Laser:=TRUE;
		
	END_IF
	
	Deg_Laser_partiel_ok:= ABS(Pos_cible_Z_Laser-Ep_retract_partiel_torche_temp)<2 ;		
	(*<2 car 1.7 mm d'inertie*)
	
	IF Deg_Laser_partiel_ok			(**)
	OR Bp_Arret_Usinage THEN						(*"Bp_arus" pour arrêter le deg si on rappuie sur Arus*)
		Top_deg_Laser_partiel:=FALSE;
		memo_Fin_decoupe := FALSE;
	END_IF
	
	IF FE_Top_deg_torche_VB_partiel.Q THEN
		Top_Z_Laser :=FALSE;
	END_IF
	
(****************************** Dégagement Full de la torche (Z)******************************)
	IF  G7_Cycle_Percages_Laser.Init.x 
		AND (Ref_Ok_X_Laser AND Ref_Ok_Y_Laser AND Ref_Ok_Z_Laser AND Ref_Ok_A_Laser )
		AND ((Manu AND Selection_ZLaser AND Joystick_Cmd_Gauche)
			OR FE_mem_arus.Q
			OR RE_Fin_programme.Q )THEN	// retract en fin de programe ou FE_arus ou Repli manuel
				Top_deg_Laser_full:=TRUE;
	END_IF
	
	IF Top_deg_Laser_full THEN
		//retract Z
		Pos_cible_Z_Laser:= Pnc_axe_Z_Robot.Limite_Moins+1; //On peut se permettre de remonter completement car Z est rapide et pas bcp dde course		
		IF Retract_speed > Pnc_axe_Z_Robot.Vitesse_PTP THEN
			Vitesse_Z_Laser_PTP:= Pnc_axe_Z_Robot.Vitesse_PTP;
		ELSE
			Vitesse_Z_Laser_PTP := Retract_speed;
		END_IF
		IF NOT Top_Z_Laser THEN
			Top_Z_Laser:=TRUE;
		END_IF 	
	
	END_IF
	
	Deg_Laser_full_ok:=	Pos_Reel_Z_Laser<Pnc_axe_Z_Robot.Limite_Moins+5; //Degagement complet, torche remontee a fond
	
	IF Deg_Laser_full_ok			(**)
	OR Bp_Arret_Usinage THEN						(*"Bp_arus" pour arrêter le deg si on rappuie sur Arus*)
		Top_deg_Laser_full:=FALSE;
	END_IF
	
	IF FE_Top_deg_torche_VB_full.Q THEN
		Top_Z_Laser :=FALSE;
	END_IF

(****************************** Palpage de la torche ******************************)
 IF (Manu AND NOT mem_Arus 
 	AND Selection_ZLaser
 	AND Joystick_Cmd_Droite)THEN
 		Fct_palpage_Etal:=TRUE;
 ELSE 
 		Fct_palpage_Etal := FALSE;
 END_IF
  
 IF FE_Dec_Manu.Q OR mem_arus THEN 
 	Pv_Z_Laser := FALSE;
 	Palpage_Torche := FALSE;
 	Top_Z_Laser :=FALSE;
 END_IF
 
 IF G7_Cycle_Percages_Laser.Init.x THEN
 	limite_couple_negatif_axe_Z_Laser := 1000;
 END_IF

(****************************** Défaut collision et défaut lifter torche plasma ******************************)
 TON_anti_scintillement_collision_Laser(in :=DI01_Collision, pt:=T#100MS);
 FE_Breakaway_Plasma_ok(clk := TON_anti_scintillement_collision_Laser.Q);
 
 IF ((Auto AND CodeM_50 AND ISO_en_cours)	// si decoupe auto en cours...
 	 OR										// ...ou...
 	(Manu AND Tir_Laser)) 					// ...decoupe manu en cours...
 	AND FE_Breakaway_Plasma_ok.Q THEN		//... et perte du capteur anti collision
 		Defaut_collision_laser:=TRUE;
 END_IF
 
 IF ((Auto AND CodeM_50)						// Si sequence de decoupe plasma...
 		 OR 								// ...ou...
 		(Manu AND Tir_Laser)) 				// ...coupe manuelle...
 	AND DI01_Collision THEN		// ...et torche pas en place, alors ...
 	
 		Defaut_torche_debrayee:=TRUE;
 		// le defaut apparait au debut d'une coupe si la torche n'est pas en place ;
 		// contrairement a la colision qui apparait en cours de coupe
 END_IF

 //RAZ défaut
	IF Bp_Annul_Defauts THEN
		Defaut_torche_debrayee:=FALSE;
		Defaut_contact_torche_tole:= FALSE;	
		Test_capacitance_defectueux:=FALSE;
		Top_deg_Laser_full:=FALSE;
		Top_deg_Laser_partiel:=FALSE;
		memo_contact_torche_tole := FALSE;
	END_IF

 TON_contact_torche_tole(in :=  
		G7_Cycle_Percages_Laser.Init.x 										// permet de couper le plasma en cas de collision non brutale avec la tole
		AND sequence[Pt_sequence].M=50 AND NOT F_M10						//  défaut unniquement pendant une coupe plasma si on ne bloque pas la troche.
		AND NOT blocage_asserv_gde_variation						// pour ne pas passer en défaut si une pièce bascule en fin de coupe CCC : pas de M10 sur les ponts
		AND Tir_Laser
		, pt := T#0.5S);

 IF TON_contact_torche_tole.Q
 THEN
 	Defaut_contact_torche_tole:= TRUE;										(* a tester : risque de contacts parasites avec les gerbes de plasma*)
 END_IF

 IF F_ISO.Q THEN 				
	 Asserv_Torche_On_test:=
	 Asserv_Torche_On:=
	 Start_ISO3D:=FALSE;
 END_IF
 
//Calcul position sommet théorique pour cornière en cours - Hypothèses : épaisseurs correcte et cornière posée parfaitement sur bati
	F1X1:=Hauteur_aile-20-Ep_ame;	
	F1X2:=15-Ep_ame;
	F1Y1:=F1Y2:= Ep_aile;
	F2X1:=F2X2:=-Ep_ame;				//rotation de -90°	X=-Y' Y=X'
	F2Y1:= -(Largeur_ame-Ep_aile-20);	//.. coordonnées des points "Derrière le sommet" donc en -
	F2Y2:= (Ep_aile-15);	;			//..

IF F1Y1 <> 0 AND F1Y2 <>0 		
	AND F2Y1 <> 0 AND F2Y2 <> 0 THEN

	(* Calcul a1 du coefficient Directeur de la Droite Coté Aile REF *)
	IF F1X1 - F1X2<>0 THEN
		a1s := (F1Y1 - F1Y2)/(F1X1 - F1X2);
		(* Calcul de l'Ordonnée à l'Origine b1 de la Droite Coté Aile REF *)
		b1s := F1Y1 - (a1s *F1X1);
	ELSE
	//Si cornière parfaite, bien posée sur le bati machine, alors F1P1.Y - F1P2.Y =0. Si c'est le cas, la droite Y1(x)=b1 avec B1 = F1P1.Y ou F1P2.Y qui sont égaux
		b1s:= F1Y1;
	END_IF
	
	(* Calcul a2 du coefficient Directeur de la Droite Coté Aile OPP REF *)
	IF F2X1 - F2X2<>0 THEN //Si cornière parfaite, bien posée sur le bati machine, alors F2P1.X - F2P2.X =0. la droite Y2(x)= F2P1.X ou F2P2.X qui sont égaux
		a2s := (F2Y1 - F2Y2) / (F2X1 - F2X2);
		(* Calcul de l'Ordonnée à l'Origine b1 de la Droite Coté Aile REF *)
		b2s := F2Y1 - (a2s * F2X1);
	END_IF
	
	IF a1s-a2s <> 0 THEN
		Y_Sommet_Pour_Aile_REF_TH := (b2s - b1s) / (a1s-a2s);
		Y_Sommet_Pour_Aile_OPP_REF_TH := a1s * Y_Sommet_Pour_Aile_REF_TH + b1s;	//Correspond 
	ELSE //Cornière parfaite, posée sur bati sans problème
		Y_Sommet_Pour_Aile_REF_TH :=F2X1;
		Y_Sommet_Pour_Aile_OPP_REF_TH := -(a1s * Y_Sommet_Pour_Aile_REF_TH + b1s);	//a1 = 0 donc c'est comme si Y=b1, et pour utiliser ça comme Y face 2 - opp réf on doit refair une rotation mais négative cette fois 
	END_IF

	(* Calcul de l'angle de la Droite 1 Aile REF *)
	Alpha1s := ATAN(a1s);
	(* Calcul de l'angle de la Droite 2 Aile OPP REF *)
	Alpha2s := ATAN(a2s);
END_IF

IF Palpage_OK_Face_1 AND Palpage_OK_Face_2 AND 	Y_Sommet_Pour_Aile_REF <>0 AND 	Y_Sommet_Pour_Aile_Opp_REF <>0 THEN
 CorrectionY_Ref:= (Y_Sommet_Pour_Aile_REF - Y_Sommet_Pour_Aile_REF_TH);	//Investiguer - Inclure angle pour correction
 CorrectionY_OppRef:= (Y_Sommet_Pour_Aile_Opp_REF - Y_Sommet_Pour_Aile_OPP_REF_TH);	

END_IF



]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>