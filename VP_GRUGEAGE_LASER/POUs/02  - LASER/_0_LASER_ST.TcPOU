<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="_0_LASER_ST" Id="{91b66463-cd76-4a43-9a21-35f5c7e7036d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM _0_LASER_ST
VAR
	//Choix face
	 Fb_decode_real_Fct_M_			: Fb_decode_real;
	 Num_Unite_Cycle_Auto			: INT;
	 Num_operation_Cycle 				: INT;
	//Asservissement pression
	 Asserv_Pression				:FB_BasicPID;
	  P							:LREAL:=0.6;	//Pour essais lors du test asservissement
	  I							:LREAL:=1;	//Pour essais lors du test asservissement
	  D							:LREAL;	//Pour essais lors du test asservissement
	  Td						:LREAL;	//Pour essais lors du test asservissement   
	  Test_asserv				:BOOL;
	
	  
	 t_floppy1	:BOOL;	//sert de test, à suppr dans ver finale
	 j	:INT;
	 
	 LaserTYpe	:UINT;
	 PasswordDisplay	:UINT;
	 
	//Test impulsion laser 
	 Pulse_Tir		:TP;	// Impulsion de tir laser
	 Dmd_Test_Tir	:BOOL; //Test pour demander une petite impulsion de tir laser
	 Mode_Test_Tir: BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Quelle face en cours ? 
 IF		ABS(Pos_reel_A_Laser - 45)<0.1 AND En_Pos_A_Laser AND NOT Top_A_Laser THEN
 			Face_En_Cours := 1;
 ELSIF 	ABS(Pos_reel_A_Laser - (-45))<0.1 AND En_Pos_A_Laser AND NOT Top_A_Laser THEN
 			Face_En_Cours := 2;
 ELSIF 	ABS(Pos_reel_A_Laser - (-90))<0.1 AND En_Pos_A_Laser AND NOT Top_A_Laser THEN
 			Face_En_Cours := 3;
 ELSE
 			Face_En_Cours := 0;
 END_IF;
 
 Face_En_Pos := Face_Cible <> 0 AND Face_En_Cours <> 0 AND Face_Cible = Face_En_Cours;
 IF Top_Face AND Face_En_Pos THEN
 	Top_Face := FALSE;
 END_IF;
 
//Selection recette reçue du Driver
 //En manu
 IF Manu THEN 	// Que en manu pour eviter de parcourir les tableaux pour rien
 	FOR j := 0 TO 500 DO 
 		IF Ep_aile <> 0 AND Tab_St_Recette_Laser[j].Epaisseur = Ep_aile AND Tab_St_Recette_Laser[j].Type_Process = 1 THEN 
 			 Index_Recette_Marquage := J;
 		END_IF
 		IF Ep_aile <> 0 AND Tab_St_Recette_Laser[j].Epaisseur = Ep_aile AND Tab_St_Recette_Laser[j].Type_Process = 0 THEN 
 			 Index_Recette_Decoupe := J;
 		END_IF
 	END_FOR
 END_IF
  
IF Tab_St_Recette_Laser[Index_Recette_Decoupe].Tb_Dec.Puissance_Laser = 0 THEN Sel_DecMarq_Manu:=TRUE; END_IF //Pas de recette de découpe, on force le marquage
IF Index_Recette_Marquage = 0 OR Tab_St_Recette_Laser[499].Tb_Dec.Puissance_Laser=0 THEN	//Forcage d'une recette de marquage, données vient du fichier de recette crée/actualisé par BEM
	Index_Recette_Marquage:=499;
	 Tab_St_Recette_Laser[499].Epaisseur := Ep_aile;
	 Tab_St_Recette_Laser[499].Nb_Etape_Perc:=0;
	 Tab_St_Recette_Laser[499].Type_Process:=1;
	 Tab_St_Recette_Laser[499].Taille_Buse:=1.2;
	 Tab_St_Recette_Laser[499].Type_Gaz:=1; 
	 Tab_St_Recette_Laser[499].Tb_Dec.Pression_Gaz:=2;
	 Tab_St_Recette_Laser[499].Tb_Dec.Distance_Focale:=0;
	 Tab_St_Recette_Laser[499].Tb_Dec.Puissance_Laser:=600;
	 Tab_St_Recette_Laser[499].Tb_Dec.Duty_Cycle:=20;
 	 Tab_St_Recette_Laser[499].Tb_Dec.Frequence_impulsion:=1000;
	 Tab_St_Recette_Laser[499].Tb_Dec.Hauteur_Buse:=15;
END_IF
 
//Raz du tableau de recettes
 //Recette pour raz
  Recette_LaserNULL.Angle:=0;
  Recette_LaserNULL.Epaisseur:=0;
  Recette_LaserNULL.Id_Driver:=0;
  Recette_LaserNULL.Nb_Etape_Perc:=0;
  Recette_LaserNULL.Perp_Chanfrein:=0;
  Recette_LaserNULL.Prof_Marq:=0;
  Recette_LaserNULL.Prof_Marq:=0;
  Recette_LaserNULL.Saignee:=0;
  Recette_LaserNULL.Taille_Buse:=0;
  Recette_LaserNULL.Type_Buse:=0;
  Recette_LaserNULL.Type_Gaz:=0;
  Recette_LaserNULL.Type_Matiere:=0;
  Recette_LaserNULL.Type_Process:=0;
  Recette_LaserNULL.Tb_Dec.Distance_Focale:=0;
  Recette_LaserNULL.Tb_Dec.Duty_Cycle:=0;
  Recette_LaserNULL.Tb_Dec.Frequence_impulsion:=0;
  Recette_LaserNULL.Tb_Dec.Hauteur_Buse:=0;
  Recette_LaserNULL.Tb_Dec.Pression_Gaz:=0;
  Recette_LaserNULL.Tb_Dec.Puissance_Laser:=0;
  Recette_LaserNULL.Tb_Dec.Tps_phase_perc:=0;
  Recette_LaserNULL.Tb_Dec.Vitesse_Decoupe:=0;
  FOR j :=1 TO 5 DO 
  	Recette_LaserNULL.Tb_Perc[j].Distance_Focale:=0;
  	Recette_LaserNULL.Tb_Perc[j].Duty_Cycle:=0;
  	Recette_LaserNULL.Tb_Perc[j].Frequence_impulsion:=0;
  	Recette_LaserNULL.Tb_Perc[j].Hauteur_Buse:=0;
  	Recette_LaserNULL.Tb_Perc[j].Pression_Gaz:=0;
  	Recette_LaserNULL.Tb_Perc[j].Puissance_Laser:=0;
  	Recette_LaserNULL.Tb_Perc[j].Tps_phase_perc:=0;
  	Recette_LaserNULL.Tb_Perc[j].Vitesse_Decoupe:=0;
  END_FOR

 IF B_RazRecettes THEN 
	FOR j := 0 TO 500 DO 
		Tab_St_Recette_Laser[j]:= Recette_LaserNULL;
	END_FOR
 END_IF 
 

//Palpage sommet
 (* Aile Ref *)
 	Palp_R[1].R11.X := 551.16;
 	Palp_R[1].R11.Y := 267.23;
 	Palp_R[1].R11.Z := 293.45;
 
 	Palp_R[1].R21.X := 1138.34;
 	Palp_R[1].R21.Y := 318.60;
 	Palp_R[1].R21.Z := 397.38;
 
 	Palp_R[1].R19.X := 535.25;
 	Palp_R[1].R19.Y := 466.41;
 	Palp_R[1].R19.Z := 284.86;
 
 	Palp_R[1].R00.X := 346.26;
 	Palp_R[1].R00.Y := 349.59;
 	Palp_R[1].R00.Z := 254.30;
 
 
 (* Aile Ame *)
 	Palp_R[2].R11b.X := 542.80;
 	Palp_R[2].R11b.Y := 371.90;
 	Palp_R[2].R11b.Z := 288.93;
 
 	Palp_R[2].R21b.X := 1129.98;
 	Palp_R[2].R21b.Y := 423.27;
 	Palp_R[2].R21b.Z := 392.87;
 
 	Palp_R[2].R13.X := 522.80;
 	Palp_R[2].R13.Y := 375.11;
 	Palp_R[2].R13.Z := 400.34;
 
 	Palp_R[2].R00.X := 301.70;
 	Palp_R[2].R00.Y := 361.75;
 	Palp_R[2].R00.Z := 500.04;
 
 
 (* Aile Opp Ref *)
 	Palp_R[3].R11.X := 462.84;
 	Palp_R[3].R11.Y := 281.40;
 	Palp_R[3].R11.Z := 785.38;
 
 	Palp_R[3].R21.X := 1050.03;
 	Palp_R[3].R21.Y := 332.77;
 	Palp_R[3].R21.Z := 889.32;
 
 	Palp_R[3].R19.X := 446.94;
 	Palp_R[3].R19.Y := 480.58;
 	Palp_R[3].R19.Z := 776.79;
 
 	Palp_R[3].R00.X := 257.95;
 	Palp_R[3].R00.Y := 363.76;
 	Palp_R[3].R00.Z := 746.23;

//Gestion des gaz : Consigne a la servo de 0-27648-> 0-30Bars + Activ EV gaz O2, Air ou N2
 IF Start_Gaz OR Test_asserv THEN  
 	Asserv_Pression.fSetpointValue:=Consigne_Pression_Gaz;
 	Asserv_Pression.fActualValue:=(INT_TO_LREAL(Data14_Cutting_Gas_Pressure)/100);
 	Asserv_Pression.fKp:=P;
 	Asserv_Pression.fTn:=I;
 	Asserv_Pression.fTv:=D;
 	Asserv_Pression.fTd:=Td;
 	Asserv_Pression.fCtrlCycleTime:=0.01;
 	Asserv_Pression.bReset:=(Consigne_Pression_Gaz=0);
 	
 	Asserv_Pression();
 	Consigne_ServoVanne:=LREAL_TO_UINT ((Consigne_Pression_Gaz + Asserv_Pression.fCtrlOutput) * 27648 / 30); 
	
	Byte1_Convert := UINT_TO_BYTE(Consigne_ServoVanne);
 	Byte0_Convert := UINT_TO_BYTE(SHR(Consigne_ServoVanne,8));
 ELSE
 	Byte1_Convert := 
 	Byte0_Convert := 0;	

 END_IF

 Ev_GazLaser_Oxygene:= Start_Gaz AND Type_gaz = 0;
 Ev_GazLaser_Azote:= Start_Gaz AND Type_gaz = 1;
 Ev_GazLaser_Air:= Start_Gaz AND Type_gaz = 2;
 
 
//Autorisation ouverture gâche sécurisée
 //Evacuation air cabine
  Tps_Aspiration:=REAL_TO_TIME(Volume_Cabine/Debit_Aspiration*1000);
  TON_Air_Cabine(in:= NOT Tir_Laser AND K_service_Aspiration,pt:=Tps_Aspiration); //tps en ms
  IF Tir_laser THEN
	  Evac_Air_Cabine_ok:=FALSE;
  ELSIF TON_Air_Cabine.Q THEN
	  Evac_Air_Cabine_ok:=TRUE;
  END_IF
  
  
  
  Re_DmdVerrDeverr_Porte(clk:=Dmd_VerrDeverr_Porte);
  
 Autor_Ouverture_Porte:= Evac_Air_Cabine_ok;
 IF Re_DmdVerrDeverr_Porte.Q AND NOT Mem_Arus THEN Attente_Arret_Propre :=TRUE; END_IF //Demande d'ouverture porte : on attend de finir le cycle en cours
 IF Autor_Ouverture_Porte OR t_floppy1 THEN
 	IF Re_DmdVerrDeverr_Porte.Q AND Mem_Arus THEN 
		K_VerrDeverr_PorteLaser:=TRUE; 
		Attente_Arret_Propre:=FALSE;
	END_IF			//Machine à l'arrêt, on déverrouille l'interlock -FC : quel pilotage ? true := déverrouillé false = verrouillé OU sur front permutation entre l'un et l'autre 
 	IF Bp_Raz_Pnoz_Laser AND Mem_Arus THEN 
		K_VerrDeverr_PorteLaser:=FALSE; 
	END_IF	//Machine à l'arrêt, on verrouille l'interlock 
 END_IF
 
 //Raz pnoz porte et module laser
 RAZ_Pnoz_PorteLaser := Bp_Raz_Pnoz_Laser ;
 RAZ_Pnoz_Laser:=  Porte_Laser_Fermee;
 
 
LaserTYpe:=UDINT_TO_UINT(Source_MaxPhotonics.PROGRAM_NUMBER_IN);
PasswordDisplay :=UDINT_TO_UINT(SHR(Source_MaxPhotonics.PROGRAM_NUMBER_IN,16));
	
//Impulsion test laser
 IF Mode_Test_Tir AND Manu THEN  
 	Pulse_Tir(in:=Dmd_Test_Tir,PT:=T#50MS);
 END_IF
	
	
	
	
	
	
	
	
	]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>