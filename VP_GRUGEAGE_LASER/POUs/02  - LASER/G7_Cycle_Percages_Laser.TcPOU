<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="G7_Cycle_Percages_Laser" Id="{16171f1d-ee12-450b-884e-b1e87b3287ba}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM G7_Cycle_Percages_Laser	//Phases de perçages laser 
VAR_INPUT	SFCInit:BOOL;	END_VAR
VAR
	TON_Percage	:TON;	//Signal quand on a percé pendant Tps_phase_perc = phase de perçage finie, on peut continuer
	Index_Recette_Choisie	:INT;
	Tolerence_Capa	:real;	//Capacitance soumise a des perturbations qui augmente avec la distance. DIstance typique : Perc / decoupe = env 2mm, perturbation quasi nulle - Marquage = env15mm ecart type de 0.6mm  
	StepTest	:INT;	//Pour test en pas à pas
	TON_ZEnPos	:TON;	//Pour qttendre le Z laser
	TON_ZEnPos_b	:TON;	//Pour qttendre le Z laser

END_VAR
]]></Declaration>
