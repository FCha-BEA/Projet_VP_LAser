    <Action Name="Init_active" Id="{b84e6206-9148-4ebb-8eae-f5089194580a}">
      <Implementation>
        <ST><![CDATA[RE_Top_Laser(clk:=Top_perc_laser);
Laser_ok_pour_decoupe:=FALSE;
Phase_perc_encours:=1;

TON_ZEnPos(in:=FALSE);
TON_ZEnPos_b(in:=FALSE);

]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step10_entry" Id="{2bb15733-e641-464d-bd4e-45156e223342}">
      <Implementation>
        <ST><![CDATA[IF NOT Grugeage_laser THEN //Découpe avec plusieurs phase de perçage ou simple gravage
	IF Tab_St_Recette_Laser[Index_Recette_Choisie].Type_Process = 0  THEN  
		Consigne_Pression_Gaz						:=	Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Perc[Phase_perc_encours].Pression_Gaz; //Découpe 
		PLC_Prog_Power_Watt_Target					:=	LREAL_TO_UDINT(Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Perc[Phase_perc_encours].Puissance_Laser);
		PLC_Prog_Per_Cent_Of_Duty_Cycle_Target		:=	LREAL_TO_UDINT(Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Perc[Phase_perc_encours].Duty_Cycle);
		PLC_Prog_Frequency_0_20000Hz_Target			:=	LREAL_TO_UDINT(Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Perc[Phase_perc_encours].Frequence_impulsion);
		Prog_Distance_Focal_Demandee 				:=	Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Perc[Phase_perc_encours].Distance_Focale;
	ELSE
		Consigne_Pression_Gaz						:=	Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Dec.Pression_Gaz;	//marquage
		PLC_Prog_Power_Watt_Target					:=	LREAL_TO_UDINT(Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Dec.Puissance_Laser);
		PLC_Prog_Per_Cent_Of_Duty_Cycle_Target		:=	LREAL_TO_UDINT(Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Dec.Duty_Cycle);
		PLC_Prog_Frequency_0_20000Hz_Target			:=	LREAL_TO_UDINT(Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Dec.Frequence_impulsion);
		Prog_Distance_Focal_Demandee 				:=	Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Dec.Distance_Focale;

	END_IF
ELSE 
	Consigne_Pression_Gaz						:=	Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Dec.Pression_Gaz;	
	PLC_Prog_Power_Watt_Target					:=	LREAL_TO_UDINT(Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Dec.Puissance_Laser);
	PLC_Prog_Per_Cent_Of_Duty_Cycle_Target		:=	LREAL_TO_UDINT(Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Dec.Duty_Cycle);
	PLC_Prog_Frequency_0_20000Hz_Target			:=	LREAL_TO_UDINT(Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Dec.Frequence_impulsion);
	Prog_Distance_Focal_Demandee 				:=	Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Dec.Distance_Focale;
END_IF


]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step20_active" Id="{b7ec6f98-9eac-4984-8523-659733601c36}">
      <Implementation>
        <ST><![CDATA[IF Tab_St_Recette_Laser[Index_Recette_Choisie].Type_Process = 0 THEN
	TON_Percage.PT:= LREAL_TO_TIME(Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Perc[Phase_perc_encours].Tps_phase_perc);
ELSE
	TON_Percage.PT:= T#20MS;	//Marquage de temps de perçage
END_IF
TON_Percage(IN:=Tir_en_Cours);]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step20_entry" Id="{d829b634-5ad5-45ae-b9cb-72b012df8f12}">
      <Implementation>
        <ST><![CDATA[TON_Percage(IN:=FALSE);

IF NOT Tir_Laser THEN 
	Tir_Laser:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step20_exit" Id="{4658cea6-ee01-4078-8efe-f97a8c0dcc3b}">
      <Implementation>
        <ST><![CDATA[IF Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Perc[Phase_perc_encours+1].Puissance_Laser<>0 THEN 
	Phase_perc_encours := Phase_perc_encours+1;
END_IF

TON_Percage(in:=FALSE);]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step22_active" Id="{57f85465-0fc2-4311-a246-45ba21b24c1c}">
      <Implementation>
        <ST><![CDATA[TON_Percage(in:=En_pos_Z_Laser,pt:=LREAL_TO_TIME(Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Perc[Phase_perc_encours].Tps_phase_perc));]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step22_entry" Id="{e148cc42-f90f-44b1-aa74-1d75ffefd275}">
      <Implementation>
        <ST><![CDATA[Phase_perc_encours := Phase_perc_encours+1;
TON_Percage(in:=FALSE);

Consigne_Pression_Gaz						:=	Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Perc[Phase_perc_encours].Pression_Gaz; 
PLC_Prog_Power_Watt_Target					:=	LREAL_TO_UDINT(Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Perc[Phase_perc_encours].Puissance_Laser);
PLC_Prog_Per_Cent_Of_Duty_Cycle_Target		:=	LREAL_TO_UDINT(Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Perc[Phase_perc_encours].Duty_Cycle);
PLC_Prog_Frequency_0_20000Hz_Target			:=	LREAL_TO_UDINT(Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Perc[Phase_perc_encours].Frequence_impulsion);
Prog_Distance_Focal_Demandee 				:=	Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Perc[Phase_perc_encours].Distance_Focale;
En_pos_Z_Laser := FALSE;
Pos_cible_Z_Laser :=Pos_Reel_Z_Laser +  
	(Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Perc[Phase_perc_encours-1].Hauteur_Buse
		-Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Perc[Phase_perc_encours].Hauteur_Buse); 
	//On avance pour être à la hauteur suivante. Pas d'asservissement car lors du perçage des perturbations peuvent fausser la capacitance
Top_Z_Laser	:=TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step30_active" Id="{f8a7fb90-8063-4f72-92b3-9919f23841f9}">
      <Implementation>
        <ST><![CDATA[IF ABS(Prog_Capacitance_Actual_Value_mm-Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Dec.Hauteur_Buse)<Tolerence_Capa
(*AND En_pos_Z_Laser
AND NOT Top_Z_Laser*)
AND (Tir_en_Cours or Grugeage_laser) THEN
	Laser_ok_pour_decoupe:=TRUE;
END_IF

IF Tab_St_Recette_Laser[Index_Recette_Choisie].Type_Process = 0 THEN
	Asserv_Torche_On:=TRUE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step30_entry" Id="{2eec282b-42d8-4ea9-b3c5-46a1f9bd35a4}">
      <Implementation>
        <ST><![CDATA[IF Tab_St_Recette_Laser[Index_Recette_Choisie].Type_Process = 0 
and NOT Grugeage_laser AND NOT Gravage_Laser THEN //Go to pos + envoi datas découpe après perçage
	Consigne_Pression_Gaz						:=	Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Dec.Pression_Gaz; 
	PLC_Prog_Power_Watt_Target					:=	LREAL_TO_UDINT(Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Dec.Puissance_Laser);
	PLC_Prog_Per_Cent_Of_Duty_Cycle_Target		:=	LREAL_TO_UDINT(Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Dec.Duty_Cycle);
	PLC_Prog_Frequency_0_20000Hz_Target			:=	LREAL_TO_UDINT(Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Dec.Frequence_impulsion);
	Prog_Distance_Focal_Demandee 				:=	Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Dec.Distance_Focale;

	Pos_cible_Z_Laser:= Pos_Reel_Z_Laser + 
		(Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Perc[Phase_perc_encours].Hauteur_Buse 
			- Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Dec.Hauteur_Buse);
	En_pos_Z_Laser:=FALSE;
	Top_Z_Laser:=TRUE;
END_IF


]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step31_entry" Id="{a5e8ff7d-9e35-4ea0-9153-a914a4adbf11}">
      <Implementation>
        <ST><![CDATA[Phase_perc_encours := Phase_perc_encours+1;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step5_active" Id="{5c1bc9a7-c893-45cb-90e9-c8fa48d0ec94}">
      <Implementation>
        <ST><![CDATA[TON_ZEnPos(IN:=En_pos_Z_Laser, pt:=t#20ms);]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step5_entry" Id="{bb7c64dd-3352-4e9c-b911-4e491eb51e3b}">
      <Implementation>
        <ST><![CDATA[Type_gaz:= Tab_St_Recette_Laser[Index_Recette_Choisie].Type_Gaz;
Start_Gaz:=TRUE;

IF auto THEN 	
	IF NOT Grugeage_laser AND NOT Gravage_Laser THEN	//Découpe
		Pos_cible_Z_Laser		:=Pos_ref_torche - Tab_St_Recette_Laser[Index_Recette_Laser_Auto].Tb_Perc[Phase_perc_encours].Hauteur_Buse-Ep_secu;
		Recette_Hauteur_Buse 	:= Tab_St_Recette_Laser[Index_Recette_Laser_Auto].Tb_Perc[Phase_perc_encours].Hauteur_Buse;
	ELSE //Gravage ou grugeage - On utilise directement les données de découpe
		Pos_cible_Z_Laser		:=Pos_ref_torche - Tab_St_Recette_Laser[Index_Recette_Laser_Auto].Tb_Dec.Hauteur_Buse-Ep_secu; 
		Recette_Hauteur_Buse 	:= Tab_St_Recette_Laser[Index_Recette_Laser_Auto].Tb_Dec.Hauteur_Buse;
	END_IF
	Index_Recette_Choisie:=Index_Recette_Laser_Auto;
ELSE 	//Commande en manu
	IF NOT Sel_DecMarq_Manu THEN//Découpe - Seulement si présence recette de découpe
		Pos_cible_Z_Laser		:=Pos_ref_torche - Tab_St_Recette_Laser[Index_Recette_Decoupe].Tb_Perc[Phase_perc_encours].Hauteur_Buse-Ep_secu;
		Index_Recette_Choisie	:=Index_Recette_Decoupe;
		Recette_Hauteur_Buse	:=Tab_St_Recette_Laser[Index_Recette_Decoupe].Tb_Perc[Phase_perc_encours].Hauteur_Buse;
	ELSE 	//Marquage - Choix OP ou absence recette découpe   
		Pos_cible_Z_Laser		:=Pos_ref_torche - Tab_St_Recette_Laser[Index_Recette_Marquage].Tb_Dec.Hauteur_Buse-Ep_secu; 
		Index_Recette_Choisie	:=Index_Recette_Marquage;
		Recette_Hauteur_Buse	:=Tab_St_Recette_Laser[Index_Recette_Marquage].Tb_Dec.Hauteur_Buse;
	END_IF
END_IF

En_pos_Z_Laser:=FALSE;
Vitesse_Z_Laser_PTP:= Pnc_axe_Z_Robot.Vitesse_PTP;
Top_Z_Laser:=TRUE;

IF Tab_St_Recette_Laser[Index_Recette_Choisie].Type_Process = 0 THEN 
	Tolerence_Capa := 0.3;
ELSE
	Tolerence_Capa :=1;
END_IF

TON_ZEnPos(in:=false);
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step6_active" Id="{8557ea5b-a488-4e4f-9682-4ed029c02015}">
      <Implementation>
        <ST><![CDATA[TON_ZEnPos_b(IN:= En_pos_Z_Laser,pt:=t#20ms);]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step6_entry" Id="{5c88b588-334d-408b-82c2-0d809f0bd1d2}">
      <Implementation>
        <ST><![CDATA[TON_ZEnPos(in:=FALSE);
TON_ZEnPos_b(in:=FALSE);

IF auto THEN 	
	IF NOT Grugeage_laser AND NOT Gravage_Laser THEN	//Découpe
		Pos_cible_Z_Laser		:=Pos_ref_torche - Tab_St_Recette_Laser[Index_Recette_Laser_Auto].Tb_Perc[Phase_perc_encours].Hauteur_Buse;
		Recette_Hauteur_Buse 	:= Tab_St_Recette_Laser[Index_Recette_Laser_Auto].Tb_Perc[Phase_perc_encours].Hauteur_Buse;
	ELSE //Gravage ou grugeage - On utilise directement les données de découpe
		Pos_cible_Z_Laser		:=Pos_ref_torche - Tab_St_Recette_Laser[Index_Recette_Laser_Auto].Tb_Dec.Hauteur_Buse; 
		Recette_Hauteur_Buse 	:= Tab_St_Recette_Laser[Index_Recette_Laser_Auto].Tb_Dec.Hauteur_Buse;
	END_IF
	Index_Recette_Choisie:=Index_Recette_Laser_Auto;
ELSE 	//Commande en manu
	IF NOT Sel_DecMarq_Manu THEN//Découpe - Seulement si présence recette de découpe
		Pos_cible_Z_Laser		:=Pos_ref_torche - Tab_St_Recette_Laser[Index_Recette_Decoupe].Tb_Perc[Phase_perc_encours].Hauteur_Buse;
		Index_Recette_Choisie	:=Index_Recette_Decoupe;
		Recette_Hauteur_Buse	:=Tab_St_Recette_Laser[Index_Recette_Decoupe].Tb_Perc[Phase_perc_encours].Hauteur_Buse;
	ELSE 	//Marquage - Choix OP ou absence recette découpe   
		Pos_cible_Z_Laser		:=Pos_ref_torche - Tab_St_Recette_Laser[Index_Recette_Marquage].Tb_Dec.Hauteur_Buse; 
		Index_Recette_Choisie	:=Index_Recette_Marquage;
		Recette_Hauteur_Buse	:=Tab_St_Recette_Laser[Index_Recette_Marquage].Tb_Dec.Hauteur_Buse;
	END_IF
END_IF

En_pos_Z_Laser:=FALSE;
Vitesse_Z_Laser_PTP:= 10;
Top_Z_Laser:=TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step6_exit" Id="{d137011a-8115-4307-bca8-87cb75e64d0f}">
      <Implementation>
        <ST><![CDATA[if not Grugeage_laser then Asserv_Torche_On:=false; end_if 	//On doit garder l'asserv car si Deb_Tir_HorsMatiere, on se met en pos et on exec l'iso]]></ST>
      </Implementation>
    </Action>
    <Transition Name="Trans0" Id="{450c4bfc-326d-455e-addf-44241f17a440}">
      <Implementation>
        <ST><![CDATA[RE_Top_Laser.Q 
AND Prog_Source_Prete_Pour_Decoupe 
AND Prog_Capacitance_Calibration_OK 
AND DI05_Homing_finished
//AND Presseur_Amont_K11.Presseur_EnPlace
//AND Presseur_Aval_L12.Presseur_EnPlace]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans10" Id="{a4250394-6059-47e2-a02a-d5aa77c45abf}">
      <Implementation>
        <ST><![CDATA[( (Tab_St_Recette_Laser[Index_Recette_Choisie].Type_Gaz <> 0 )
OR  
	ABS((Data14_Cutting_Gas_Pressure/100)-Consigne_Pression_Gaz)<0.5 
)		
//AND ABS(_1_LASER.Feedback_Laser_Power_Watts-PLC_Prog_Power_Watt_Target)<100			
//AND ABS(_1_LASER.Feedback_Laser_Duty-PLC_Prog_Per_Cent_Of_Duty_Cycle_Target)<1 	
//AND	ABS(_1_LASER.Feedback_Laser_Freq-PLC_Prog_Frequency_0_20000Hz_Target)<2 	
AND	ABS(Prog_Distance_Focal_Reelle-Prog_Distance_Focal_Demandee)<0.05 			
AND G7_Cycle_Percages_Laser.Step10.t>T#200MS
AND NOT Top_Z_Laser
AND En_pos_Z_Laser
]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans20" Id="{88ad83f0-f70a-47b1-9e41-3ef44546b769}">
      <Implementation>
        <ST><![CDATA[TON_Percage.Q
]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans20a" Id="{8c414336-6b61-48d2-b5b8-e1a737a8c372}">
      <Implementation>
        <ST><![CDATA[TON_Percage.Q
and
Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Perc[Phase_perc_encours+1].Puissance_Laser=0	//Pas de phase suivante ?]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans20b" Id="{b951d7ca-07cf-42fc-8dd1-666bd3dbd5bd}">
      <Implementation>
        <ST><![CDATA[TON_Percage.Q
AND Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Perc[Phase_perc_encours+1].Puissance_Laser>0;]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans30" Id="{4e42bc20-327c-43d3-b2c1-6afeece3986d}">
      <Implementation>
        <ST><![CDATA[Step30.t>T#20ms and Laser_ok_pour_decoupe]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans31" Id="{a0b2db63-c130-4100-9330-8eabaf1421ff}">
      <Implementation>
        <ST><![CDATA[(auto AND NOT G7_General.Step220.x)
OR (FE_Dec_Manu.Q)]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans5" Id="{ba7cd7de-5948-4c20-a69f-e499e51c6e80}">
      <Implementation>
        <ST><![CDATA[TON_ZEnPos.Q]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans6" Id="{cea0e719-a375-40ba-9731-83a32c5f1b90}">
      <Implementation>
        <ST><![CDATA[NOT Grugeage_laser 
AND 
Step6.t>T#20MS AND 
En_pos_Z_Laser AND NOT Top_Z_Laser and TON_ZEnPos_b.Q
AND 
( (Tab_St_Recette_Laser[Index_Recette_Choisie].Type_Process = 0 AND 
	ABS(Prog_Capacitance_Actual_Value_mm - Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Perc[Phase_perc_encours].Hauteur_Buse) <Tolerence_Capa)
  OR (Tab_St_Recette_Laser[Index_Recette_Choisie].Type_Process = 1 AND 
  	ABS(Prog_Capacitance_Actual_Value_mm - Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Dec.Hauteur_Buse)<Tolerence_Capa)
)]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans6b" Id="{b89cfb88-6451-44d4-bdbd-3df2da931b8f}">
      <Implementation>
        <ST><![CDATA[Grugeage_laser 
AND 
En_pos_Z_Laser AND NOT Top_Z_Laser AND TON_ZEnPos_b.Q
AND
ABS(Prog_Capacitance_Actual_Value_mm - Tab_St_Recette_Laser[Index_Recette_Choisie].Tb_Dec.Hauteur_Buse)<Tolerence_Capa
]]></ST>
      </Implementation>
    </Transition>
