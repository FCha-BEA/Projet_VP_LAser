  <POU Name="G7_General" Id="{5f9f3406-b176-444b-8d98-626ce3907be7}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM G7_General
VAR_INPUT	SFCInit:BOOL;	END_VAR
VAR
	Memo_X_Precedent	:LREAL;	//Si plusieurs usinages au même X, pas besoin d'ouvrir et dég à chaque fois 
	Top_Cycles_Palp_Laser	:BOOL; //Lance le G7 des palpages buse et sommet du laser
	Fb_decode_real_Fct_M_: Fb_decode_real;
	Num_Unite_Cycle_Auto: INT;
	Num_operation_Cycle: INT;
	
	FE_Prepa_ISO_3D, FE_ISO_en_cours: F_trig;
	TON_ISO_en_cours, TON_Fin_Decoupe	:Ton;
	

END_VAR
]]></Declaration>
