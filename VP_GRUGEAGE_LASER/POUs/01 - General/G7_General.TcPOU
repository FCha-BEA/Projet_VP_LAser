    <Transition Name="_tTrans210_1" Id="{3fac5508-bcbc-4a34-932a-bd11aa626656}">
      <Implementation>
        <ST><![CDATA[FE_Prepa_ISO_3D.Q 
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="TransitionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="Boolean">System.Boolean</Type>
            <Type n="TransitionObjectDuplicationModeProperty">{b692d244-1e38-4327-8158-14155dcd4996}</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Transition>
    <Action Name="Step10_entry" Id="{bb8ddf34-7b46-4d2a-bb0f-9493f70d6a20}">
      <Implementation>
        <ST><![CDATA[IF Memo_X_Precedent <> Sequence[PT_Sequence].X THEN
 //Desserage presseur
  Presseur_Amont_K11.Dem_Desserrage:=
  Presseur_Aval_L12.Dem_Desserrage:=TRUE;
  Presseur_Amont_K11.Dem_Serrage:=
  Presseur_Aval_L12.Dem_Serrage:=FALSE;
 
 //Deg Z laser - Code M à voir
  IF Sequence[Pt_sequence].M<>50
  AND Sequence[Pt_sequence].M<>92
  AND Sequence[Pt_sequence].M<>93
  AND Sequence[Pt_sequence].M<>94
  AND NOT Deg_Laser_full_ok THEN
  	Top_deg_Laser_full:=TRUE; 
  END_IF
END_IF
 
// Contrôle palpage sommet
 IF Opt_Palp_Sommet_Tjs THEN	//On palpe tout le temps
 	Palpage_OK_Face_1 := Palpage_OK_Face_2 := FALSE;
 ELSIF Opt_Palp_Sommet_1Clamp THEN	// si début barre - donc seule la 1ere clamp dépassée - ou fin de barre - Fd de pince entre les 2 clamps - 
 	IF Sequence[Pt_sequence].X + Longueur_Barre_en_Pince <= Presseur_Aval_L12.Position_X
 		OR (Sequence[Pt_sequence].X >= Presseur_Amont_K11.Position_X AND Sequence[Pt_sequence].X < Presseur_Aval_L12.Position_X) THEN
 		Palpage_OK_Face_1 := Palpage_OK_Face_2 := FALSE;
 	ELSE
 		Palpage_OK_Face_1 := Palpage_OK_Face_2 := TRUE;
 	END_IF
 ELSE	//Si aucune des options de palpage, alors on ne palpe jamais
 	Palpage_OK_Face_1 := Palpage_OK_Face_2 := TRUE;
 END_IF

// Choix de la face d'usinage  
 IF Auto AND G7_Palpage_Sommet_L.Init.x THEN
 
 	(*Decodage des fonctions dans la sequence en cours*)
 	Fb_decode_real_Fct_M_(Valid:=TRUE,Real_Value:=Sequence[Pt_Sequence].M);
 	Num_Unite_Cycle_Auto:=Fb_decode_real_Fct_M_.Cent_Milliers;
 
 	Num_operation_Cycle:=LREAL_TO_INT(Sequence[Pt_Sequence].P10);
 	Decoupe := Num_operation_Cycle = 13;
 	Ecretage := Num_operation_Cycle = 15;
 
 	CASE Num_Unite_Cycle_Auto OF
 		1 : 	IF Decoupe THEN Face_Cible_Cycle := 1; END_IF;
 			IF Ecretage THEN Face_Cible_Cycle := 3; END_IF;	(* Normalement NON *)
 		2 : 	IF Decoupe THEN Face_Cible_Cycle := 2; END_IF;
 			IF Ecretage THEN Face_Cible_Cycle := 3; END_IF;
 	ELSE
 		Face_Cible_Cycle := 0;
 	END_CASE;
	
 END_IF;

]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step100_entry" Id="{93586d4c-e79e-4084-9e9e-bc2b656c8645}">
      <Implementation>
        <ST><![CDATA[IF NOT X_Suivant_Idem THEN 
 Presseur_Amont_K11.Dem_Desserrage:=
 Presseur_Aval_L12.Dem_Desserrage:=TRUE;
 Presseur_Amont_K11.Dem_Serrage:=
 Presseur_Aval_L12.Dem_Serrage:=FALSE;
END_IF

]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step110_entry" Id="{e7b29dd0-e6be-4f66-9626-84fb78622d04}">
      <Implementation>
        <ST><![CDATA[(*incrémentation pointeur*)
 Pt_Sequence:=Pt_Sequence+1;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step20_entry" Id="{9dbf7d81-53b6-4ac1-8a2a-dd36ba0e5023}">
      <Implementation>
        <ST><![CDATA[Top_Cycles_Palp_Laser:=true;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step200_Action" Id="{a514a9cd-791b-4703-b1a6-01074b7c77f3}">
      <Implementation>
        <ST><![CDATA[IF En_pos_A_Laser AND Face_Cible=Face_En_Cours THEN
	//Laser
	 IF Reprise_decoupe THEN
	 	Pos_cible_X_Laser := Pnc_Start2[8];
	 	Pos_cible_Y_Laser := Pnc_Start2[9];
	 ELSE
		 //Gestion du Y selon la face en cours car impossible de juste changer le sens de comptage du Y 
		 IF Face_En_Cours=1 THEN // face réf, pas besoin de changer/adapter
	  		Pos_cible_Y_Laser := Sequence[Pt_Sequence].P2; //A changer des que comm dispo
		 ELSIF Face_En_Cours=2 THEN // face opp réf, Y + en montant donc inversion du Y. la côté reste la même, par contre attention lors du réglage de l'offset, aussi inversé : si besoin de descendre alors on augmente l'offset !
			Pos_cible_Y_Laser := -(Sequence[Pt_Sequence].P2); //A changer des que comm dispo
		 ELSIF Face_En_Cours=3 THEN	//Face écretage, je suppose que le driver envoie une cote = hauteur sommet - ep écrzetage. Pour cette position de face, Y laser compte en montant (s'éloignant de la réf)
			 Pos_cible_Y_Laser := Sequence[Pt_Sequence].P2 - Offset_Origine_Y_Laser;  
		 END_IF
	  	Pos_cible_X_Laser := Sequence[Pt_Sequence].P1; //A changer des que comm dispo
	 END_IF
	 En_pos_X_laser:=FALSE;
	 Top_X_laser	:=TRUE;
	 En_pos_Y_laser:=FALSE;
	 Top_Y_laser	:=TRUE;
	 
	//Presseurs
	Presseur_Amont_K11.Dem_Serrage:=
	Presseur_Aval_L12.Dem_Serrage:=TRUE;
	Presseur_Amont_K11.Dem_Desserrage:=
	Presseur_Aval_L12.Dem_Desserrage:=FALSE;
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step200_Entry" Id="{1779b138-bc46-448d-89f6-71c3648c2cc1}">
      <Implementation>
        <ST><![CDATA[// Positionnement chariot 
 Pos_cible_X:=Sequence[Pt_sequence].X;
 En_Pos_X:=FALSE;
 Top_X:=TRUE;
 
//Positionnement face laser
IF Face_Cible_Cycle <> 0 THEN
	Face_Cible 		:= Face_Cible_Cycle;
	Face_En_Pos 	:= FALSE;
	Top_Face 		:= TRUE;
END_IF;

(****************************** Prepa Fichier ISO ******************************)
(*Préparation fichier nc*)
Var_temp_rep_NC:=CONCAT(DINT_TO_STRING(LREAL_TO_DINT(Sequence[Pt_sequence].P7)),'.nc');

IF Reprise_decoupe THEN
	Var_temp_rep_NC:=CONCAT(DINT_TO_STRING(LREAL_TO_DINT(Sequence[Pt_sequence].P7)),'R.nc');
END_IF

Fichier_iso:=CONCAT(Repertoire_NC_Laser,Var_temp_rep_NC);
Start_ISO3D:=FALSE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step210_active" Id="{4e8ea5b6-c17b-45b6-9942-9206653e17ac}">
      <Implementation>
        <ST><![CDATA[FE_Prepa_ISO_3D(clk := Prepa_ISO3D);
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">false</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="Step210_entry" Id="{c1be57c6-1102-4390-bc96-edd366469950}">
      <Implementation>
        <ST><![CDATA[FE_Prepa_ISO_3D(clk := FALSE);
Prepa_ISO3D := TRUE;
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">false</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="Step220_active" Id="{9d98ecdf-fcb4-420c-b88f-8132c706f74f}">
      <Implementation>
        <ST><![CDATA[TON_Ecart_Pression_Gaz
(IN:=(ABS (LREAL_TO_INT(Consigne_Pression_Gaz) - Data14_Cutting_Gas_Pressure) > Ecart_Pression_Gaz) AND Tir_Laser ,
PT:=Tmps_Ecart_Pression);


IF TON_Ecart_Pression_Gaz.Q THEN Defaut_pression_gaz :=TRUE; END_IF

	

]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step220_entry" Id="{7aaf9abd-0999-45c6-83be-75d8967a2d85}">
      <Implementation>
        <ST><![CDATA[(*Allumage torche*)
IF NOT Simul_decoupe AND NOT Bit_demo THEN
	Allumage_tete_laser:=TRUE;
END_IF		

]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="ActionObjectDuplicationModeProperty">
              <v n="Embedded">false</v>
            </o>
          </Data>
          <TypeList>
            <Type n="ActionObjectDuplicationModeProperty">{6a58c9ae-b0e2-4127-8d9c-cbfc36a09580}</Type>
            <Type n="Boolean">System.Boolean</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Action>
    <Action Name="Step220_exit" Id="{98b4d34f-b157-4045-8d74-512afd97bea2}">
      <Implementation>
        <ST><![CDATA[TON_Ecart_Pression_Gaz(in:=false);
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step221_entry" Id="{136b9709-3735-4173-9f23-c7d57741e24c}">
      <Implementation>
        <ST><![CDATA[Pos_cible_Z_Laser := pos_ref_torche - Tab_St_Recette_Laser[Index_Recette_Laser].Tb_Dec.Hauteur_Buse-Ep_secu;
En_pos_Z_Laser:=FALSE;
Top_Z_Laser:=TRUE;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step223_entry" Id="{8280820c-8759-470a-b7f0-98ca53832f93}">
      <Implementation>
        <ST><![CDATA[Pos_cible_Z_Laser := Pos_Reel_Z_Laser +( Prog_Capacitance_Actual_Value_mm -Tab_St_Recette_Laser[Index_Recette_Laser].Tb_Dec.Hauteur_Buse);
En_pos_Z_Laser:=FALSE;
Top_Z_Laser:=TRUE;

Consigne_Pression_Gaz					:=Tab_St_Recette_Laser[index_Recette_Laser].Tb_dec.Pression_Gaz;
PLC_Prog_Power_Watt_Target					:=LREAL_TO_UDINT(Tab_St_Recette_Laser[index_Recette_Laser].Tb_dec.Puissance_Laser);
PLC_Prog_Per_Cent_Of_Duty_Cycle_Target		:=LREAL_TO_UDINT(Tab_St_Recette_Laser[index_Recette_Laser].Tb_dec.Duty_Cycle);
PLC_Prog_Frequency_0_20000Hz_Target			:=LREAL_TO_UDINT(Tab_St_Recette_Laser[index_Recette_Laser].Tb_dec.Frequence_impulsion);
Prog_Distance_Focal_Demandee 			:=Tab_St_Recette_Laser[index_Recette_Laser].Tb_dec.Distance_Focale;
Start_Gaz:=TRUE; ]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step260_Action" Id="{47d2b299-c154-4f53-a0b3-9eef55b28759}">
      <Implementation>
        <ST><![CDATA[FE_ISO_en_cours(clk:=ISO_en_cours);

(*Extinction plasma en fin de découpe*)
IF F_M14 THEN
	Allumage_tete_laser:=FALSE;
END_IF

TON_Ecart_Pression_Gaz
(IN:=(ABS (LREAL_TO_INT(Consigne_Pression_Gaz) - Data14_Cutting_Gas_Pressure) > Ecart_Pression_Gaz) AND Tir_Laser AND NOT F_M14 ,
PT:=Tmps_Ecart_Pression);


IF TON_Ecart_Pression_Gaz.Q THEN Defaut_pression_gaz :=TRUE; END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step260_Entry" Id="{f163747f-7ec1-408b-8132-487fa5ad8d91}">
      <Implementation>
        <ST><![CDATA[FE_ISO_en_cours(clk:=FALSE);
TON_ISO_en_cours(in:=FALSE);
(*Démarrage éxécution programme ISO*)

Start_ISO3D:=TRUE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step260_Exit" Id="{769d3bf1-7230-4a0f-8755-01bdc63b7777}">
      <Implementation>
        <ST><![CDATA[TON_ISO_en_cours(in:=FALSE);
(*Mise à jour "Séquence effectuée"*)
IF NOT Simul_decoupe THEN		(*Si reprise à faire sur 1 et 2 mais qu'on fait l'une puis l'autre alors il ne faut pas mettre à "ok" dès la 1e. Du coup, on ne met pas à "ok" après la 2e mais on s'en fout*)
	Sequence_status[Pt_sequence].Ok:=100;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step280_Action" Id="{61e837ea-74c2-4ba4-ae56-849852214210}">
      <Implementation>
        <ST><![CDATA[TON_fin_decoupe(in:=TRUE,pt:=T#500MS);

IF (Simul_decoupe OR Bit_demo) 
AND No_Move_Z_Laser AND NOT Z_Laser_en_mode_esclave
AND TON_fin_decoupe.Q AND NOT Top_deg_Laser_full THEN
	Top_deg_Laser_full:=TRUE;
END_IF
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step280_Entry" Id="{d9ba3964-249d-4eab-90c7-2bb5530741af}">
      <Implementation>
        <ST><![CDATA[TON_fin_decoupe(in:=FALSE);
Allumage_tete_laser:=FALSE;
Tir_laser:=FALSE;
Start_ISO3D:=FALSE;
Start_Gaz:=FALSE;



]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step280_Exit" Id="{4b93cf75-66f8-457b-a23a-2b5bd36aaf94}">
      <Implementation>
        <ST><![CDATA[TON_fin_decoupe(in:=FALSE);

(*Mise à jour Status sequence effectuée*)
Sequence_Status[Pt_Sequence].OK:=100;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step40_active" Id="{dc75d40f-8215-4159-b504-7b2d64d20ef3}">
      <Implementation>
        <ST><![CDATA[IF Sequence[PT_Sequence].M=2 THEN
	IF Pos_reel_X < X_Cell_mesure_barre THEN
		Dem_Relevage_auto:=TRUE; //Compléter gestion pinces
	END_IF
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step40_entry" Id="{fd00367a-e3c8-46e7-8c42-847f0ce72a98}">
      <Implementation>
        <ST><![CDATA[Pos_Cible_X:=Sequence[Pt_Sequence].X;
En_pos_x:=FALSE;
Top_X:=TRUE;
]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step42_entry" Id="{612d719a-e90d-43db-a655-05c22e08119d}">
      <Implementation>
        <ST><![CDATA[IF Sequence[PT_Sequence].M=90 THEN
	Dem_Serrage:=FALSE;
	Dem_Desserrage:=TRUE; //Compléter gestion pinces
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step42_exit" Id="{2d37d738-63cb-44c8-8c1e-de0bb8a39c85}">
      <Implementation>
        <ST><![CDATA[Dem_Desserrage:=FALSE;

(*Mise à jour Status sequence effectuée*)
Sequence_Status[Pt_Sequence].OK:=100;]]></ST>
      </Implementation>
    </Action>
    <Action Name="Step5_entry" Id="{474fd148-0a04-4e74-9fe5-cf9fd26feb7f}">
      <Implementation>
        <ST><![CDATA[Pt_sequence:=Pt_sequence+1;
]]></ST>
      </Implementation>
    </Action>
    <Transition Name="Trans0a" Id="{dda23c8e-c927-4285-896f-d7a2ad0d4a2d}">
      <Implementation>
        <ST><![CDATA[TON_Auto.Q
AND	Sequence[Pt_Sequence].M<>0
AND	Sequence_Status[Pt_Sequence].OK=0

AND NOT Attente_Arret_Propre

]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans0b" Id="{e155ca35-c358-456b-8b4b-b0f5b65dd783}">
      <Implementation>
        <ST><![CDATA[(	Sequence[Pt_Sequence].M<>0
AND
	TON_Auto.Q
AND
	Sequence_Status[Pt_Sequence].OK=100)
	
AND NOT Attente_Arret_Propre //Si demande ouverture porte Laser


]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans10" Id="{694feb76-9865-4a22-b134-b54f1d0938f6}">
      <Implementation>
        <ST><![CDATA[Presseur_Amont_K11.Presseur_Haut
and Presseur_Aval_L12.Presseur_Haut]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans100" Id="{5b3d41cc-9a93-417f-83c3-cbceaa1e9e3b}">
      <Implementation>
        <ST><![CDATA[(Presseur_Amont_K11.Presseur_Haut and Presseur_Aval_L12.Presseur_Haut) or X_Suivant_Idem]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans10a" Id="{bdd53c74-e5db-49fd-8d60-cb7893b310fb}">
      <Implementation>
        <ST><![CDATA[(Deg_Laser_full_ok
AND Presseur_Amont_K11.Presseur_Haut
AND Presseur_Aval_L12.Presseur_Haut) OR Memo_X_Precedent = Sequence[PT_Sequence].X
AND Decoupe OR Ecretage]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans10b" Id="{38c658e5-2377-4d01-9006-11a08ea633aa}">
      <Implementation>
        <ST><![CDATA[(Deg_Laser_full_ok
AND Presseur_Amont_K11.Presseur_Haut
AND Presseur_Aval_L12.Presseur_Haut) 
AND Sequence[Pt_Sequence].M =90
OR Sequence[Pt_Sequence].M =2]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans110" Id="{c1145a46-2412-497c-aacb-ac426331fbc7}">
      <Implementation>
        <ST><![CDATA[step110.t>T#20ms]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans20" Id="{fab8237b-cf37-4cd7-87be-419e62b023dc}">
      <Implementation>
        <ST><![CDATA[G7_Master_Palpages.Init.x
AND (NOT Nv_ProcessID AND Prog_Capacitance_Calibration_OK)
AND (Palpage_OK_Face_1 AND Palpage_OK_Face_2)]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans200" Id="{22e3c04d-1447-47b5-b07f-58062277d9a2}">
      <Implementation>
        <ST><![CDATA[//Axes en pos
En_pos_X AND NOT Top_X
AND En_pos_X_Laser AND NOT Top_X_Laser
AND	En_pos_Y_Laser AND NOT Top_Y_Laser
AND En_pos_Z_Laser AND NOT Top_Z_Laser
AND En_pos_A_Laser AND NOT Top_A_Laser
//Presseurs en place
AND Presseur_Amont_K11.Presseur_EnPlace
AND Presseur_Aval_L12.Presseur_EnPlace

AND 
	Sequence[Pt_sequence].P26=Pnc_Laser[20]
	
AND step200.t>T#20MS ]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans210a" Id="{bc5b8177-fb42-4a83-ab52-0d64ff904a7c}">
      <Implementation>
        <ST><![CDATA[FE_Prepa_ISO_3D.Q 
AND Tab_St_Recette_Laser[Index_Recette_Laser].Tb_Perc[1].Puissance_Laser <>0 // La 1ère phase de perçage existe, donc il y a bien au moins une phase de perçage
AND NOT Reprise_decoupe
]]></ST>
      </Implementation>
      <ObjectProperties>
        <XmlArchive>
          <Data>
            <o xml:space="preserve" t="TransitionObjectDuplicationModeProperty">
              <v n="Embedded">true</v>
            </o>
          </Data>
          <TypeList>
            <Type n="Boolean">System.Boolean</Type>
            <Type n="TransitionObjectDuplicationModeProperty">{b692d244-1e38-4327-8158-14155dcd4996}</Type>
          </TypeList>
        </XmlArchive>
      </ObjectProperties>
    </Transition>
    <Transition Name="Trans210b" Id="{13faeb58-343f-4fab-be0b-91c1daad5107}">
      <Implementation>
        <ST><![CDATA[FE_Prepa_ISO_3D.Q 
AND Tab_St_Recette_Laser[Index_Recette_Laser].Tb_Perc[1].Puissance_Laser=0	//Pas de phase de perçage
or Reprise_decoupe]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans220" Id="{3bea94e6-fe6b-417e-b3be-70f1d5cb1342}">
      <Implementation>
        <ST><![CDATA[(*Signal arc amorcé venant de la source, après les phases de perçages  *)


(*Découpe laser*)

	(	Sequence[Pt_sequence].P1=0
	AND
	(*Torche 1*)
		((Laser_ok_pour_decoupe AND G7_Cycle_Percages_Laser.Step31.x)												(*Machine à 1:		Cas normal:					arc 1 transféré et Pierce Delay écoulé*)
		OR Simul_decoupe AND G7_Cycle_Percages_Laser.Init.x							(*Machine à 1:		Simulation de découpe:		on n'a pas allumé la torche 1 alors faut bien passer*)
		OR (Bit_demo))) //AND NOT Option_lifter_plasma_VB)							(*Machine à 1:		Mode démo:					on n'a pas allumé la torche 1 alors faut bien passer*)
		]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans221" Id="{c8eb0901-8278-40e2-95aa-286df6b1b1f2}">
      <Implementation>
        <ST><![CDATA[step221.t>T#20MS
AND En_pos_Z_Laser
and not Top_Z_Laser]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans223" Id="{ce3d769d-61b5-4e24-9e53-7de6cba5017c}">
      <Implementation>
        <ST><![CDATA[step223.t>T#20MS
AND ABS(Prog_Capacitance_Actual_Value_mm -Tab_St_Recette_Laser[Index_Recette_Laser].Tb_Dec.Hauteur_Buse) <0.5
AND Data13_Cutting_Gas_Temp			=	Consigne_Pression_Gaz	AND 			
_1_LASER.Feedback_Laser_Power	=	PLC_Prog_Power_Watt_Target	AND 		
_1_LASER.Feedback_Laser_Duty	=	PLC_Prog_Per_Cent_Of_Duty_Cycle_Target AND	
_1_LASER.Feedback_Laser_Freq	=	PLC_Prog_Frequency_0_20000Hz_Target AND		
Prog_Distance_Focal_Reelle 		= 	Prog_Distance_Focal_Demandee]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans260" Id="{e571c51e-ee71-46a5-bd1e-0a6504be934f}">
      <Implementation>
        <ST><![CDATA[(*Attente fin d'éxécution programme ISO*)
FE_ISO_en_cours.Q
]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans280" Id="{dad065d7-8c01-450e-b84e-1b00f86c56fc}">
      <Implementation>
        <ST><![CDATA[	X_no_move
AND
	TON_fin_decoupe.Q
AND
	(NOT Simul_decoupe
	OR
	(Simul_decoupe
	AND Bp_Depart_Cycle))	(*Ne surtout pas supprimer cette attente DCY en simul (+MessOp.txt), car risque de ne jamais découper les pièces simulées*)
AND
//	(NOT Bit_demo
//	OR
//	(Bit_demo
//	AND 
	Deg_Laser_full_ok
//	))
]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans40" Id="{57c2974c-58f9-4f76-8ce8-e2dc0eb0a864}">
      <Implementation>
        <ST><![CDATA[En_Pos_X
and not Top_X]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans42" Id="{0b5ace2a-c1d8-420a-be6b-d29467fd1b27}">
      <Implementation>
        <ST><![CDATA[Fin_Desserage_Pince or Sequence[Pt_Sequence].M=2]]></ST>
      </Implementation>
    </Transition>
    <Transition Name="Trans5" Id="{0fac0bc7-f62d-43f7-b714-d7592de94d68}">
      <Implementation>
        <ST><![CDATA[true]]></ST>
      </Implementation>
    </Transition>
