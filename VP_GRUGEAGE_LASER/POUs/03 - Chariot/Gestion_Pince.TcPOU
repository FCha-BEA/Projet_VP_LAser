<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Gestion_Pince" Id="{3f09525e-3e4a-4260-96db-91c3e1010bd1}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Gestion_Pince
VAR
	RE_Bit_Abaissement_pince: R_TRIG;
	RE_Bit_Relevage_pince: R_TRIG;
	Dem_Relevage_auto_auto	:BOOL;
	Pos_Z_Pince_en_Bas:BOOL;
	
	Re_Cde_Serrage_Desserrage	:R_TRIG;
	Desserrage_Pince_Ok		:TON;
	FE_Embrayage			:F_trig;
	

END_VAR
VAR_INPUT
	Memo_Bit_Relevage_pince: BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*Gestion axe Z*)
 //fronts
  RE_Bit_Abaissement_pince(clk:= Bit_Abaissement_pince );
  RE_Bit_Relevage_pince(clk:=Bit_Relevage_pince OR Dem_Relevage_auto); 
  Re_Cde_Serrage_Desserrage(clk:=Cde_Serrage_Desserrage);
  Desserrage_Pince_Ok(IN:=Ev_Desserrage_Pince,pt:=T#4S);
  FE_Embrayage(clk:=Detect_Pince_embrayee);
 
 (*Secu Pince*)
  Pince_dans_Machine:=NOT ref_ok_X OR (Ref_Ok_X AND Pos_Reel_X > X_Cell_Mesure_Barre);
  Pos_Z_Pince_en_Bas:= Ref_Ok_Z_Chariot AND ( Pos_Reel_Z_Chariot<= Pnc_Axe_Z_Chariot.Limite_Moins+ 5 );
  Stop_JOG_Plus_X_Pince_pas_en_Bas:=Pince_dans_Machine AND NOT Pos_Z_Pince_en_Bas;
 
 (*Posi Axe Z*)	//Investiguer - recul X avant de monter
 IF NOT ZChariot_Interdit THEN
  	IF RE_Bit_Abaissement_pince.Q THEN
  		Pos_cible_Z_Chariot:=Pnc_Axe_Z_Chariot.Limite_Moins+1;
  	END_IF
  	IF RE_Bit_Relevage_pince.Q THEN
  		Pos_cible_Z_Chariot:=Pnc_Axe_Z_Chariot.Limite_Plus-1;
  	END_IF
  	
  	IF NOT Mem_Arus AND Ref_Ok_Z_Chariot
  		AND (RE_Bit_Abaissement_pince.Q OR RE_Bit_Relevage_pince.Q  )  THEN
  		Top_Z_Chariot:=TRUE;
  		Memo_Bit_Relevage_pince:=FALSE;
  	END_IF
 END_IF
  
  IF Mem_Arus THEN Top_Z_Chariot:=FALSE; END_IF
  
  fdc_pince_haute := Ref_Ok_Z_Chariot AND (Pos_Reel_Z_Chariot > Pnc_Axe_Z_Chariot.Pos_Degag_2 - 5); 
  fdc_pince_Basse := Ref_Ok_Z_Chariot AND (Pos_Reel_Z_Chariot < Pnc_Axe_Z_Chariot.Pos_Degag_1 + 5);

(*Gestion pince*)
//Embrayage
 IF Machine_en_Service THEN
 	IF FE_Embrayage.Q THEN
 		Ev_Embrayage_Pince:=FALSE;
 	END_IF
 	IF Manu AND Bp_Annul_Defauts THEN
 		Ev_Embrayage_Pince:=TRUE;
 	END_IF
 END_IF
  
//Serrage desserage pince 
  IF Machine_en_Service THEN
  	IF ((Re_Cde_Serrage_Desserrage.Q AND NOT Ev_Serrage_Pince AND NOT auto) OR Dem_Serrage)  AND NOT Bit_Relevage_pince
  	THEN
  		Ev_Serrage_Pince:=TRUE;
  	END_IF
  	IF (Re_Cde_Serrage_Desserrage.Q AND NOT Ev_Desserrage_Pince AND NOT auto) or Dem_Desserrage
  	THEN
  		Ev_Serrage_Pince:=FALSE;
  	END_IF
	
  END_IF
  Ev_Desserrage_Pince:=NOT Ev_Serrage_Pince AND Machine_en_Service;
  
  Fin_Desserage_Pince := Ev_Desserrage_Pince AND Desserrage_Pince_Ok.Q;

]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>