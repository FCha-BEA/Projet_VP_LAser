  <POU Name="Axe_05_Z_Laser" Id="{8b3232da-870b-493c-8747-341602195cf2}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Axe_05_Z_Laser
VAR	
	ZLaser: FB_axe_ZLaser;
	RE_palpage_ok: R_TRIG;
	Asserv_Torche_On_test: BOOL;
	TON_Decoupe_recente		:TON;	
	FE_Decoupe_en_cours		:F_TRIG;
	TON_decoupe_manu: TON;
	TP_not_machine_en_service: TP;
	A_completer: BOOL;
	TestKerf: BOOL;
	Reset_Z: BOOL;
END_VAR
]]></Declaration>
