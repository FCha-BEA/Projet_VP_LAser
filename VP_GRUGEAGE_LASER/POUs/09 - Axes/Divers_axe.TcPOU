<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Divers_axe" Id="{a6e9f152-aea4-4f9f-9475-5b980e5e3e1c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Divers_axe
//Gestion override axes et autres
VAR
XYL_Interdit	:BOOL;
//Relevage/abaissement pince
 Pos_Parking_ZChariot	:LREAL;
DistCollision_TetePresseur	:LREAL:=20;	//Si Face ecretage, on doit retirer 20mm sinon collision tuyaux-presseur
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//Fronts, TON, etc
 RE_En_pos_X(clk:=En_pos_X);
 RE_En_pos_Z_Chariot(clk:=En_pos_Z_Chariot);
 RE_En_pos_A_Laser(clk:=En_pos_A_Laser);
 RE_En_pos_X_Laser(clk:=En_pos_X_Laser);
 RE_En_pos_Y_Laser(clk:=En_pos_Y_Laser);
 RE_En_pos_Z_Laser(clk:=En_pos_Z_Laser);

//Interdit XY Laser en Manu si pas découpe et Z trop bas pour ne pas endommager la buse ?
 XYL_Interdit := Manu AND (Offset_Z_Laser_REF-Pos_Reel_Z_Laser < 2* Global_Divers.EP_Aile) AND NOT Selection_DecManu_Laser;
 
//Limite + X Laser selon face : Si Face ecretage, on doit retirer 20mm sinon collision tuyaux-presseur 
IF Face_En_Cours=1 OR  Face_En_Cours=2 THEN 
	Limite_Plus_X_Laser:=Pnc_axe_X_Robot.Limite_Plus;
ELSE
	Limite_Plus_X_Laser:=Pnc_axe_X_Robot.Limite_Plus-DistCollision_TetePresseur;
END_IF

//Limite Z laser 
 IF Prog_Capacitance_Calibration_OK AND G7_Palpage_Capacitance.Init.x THEN
 	Limite_PLus_Z_Laser := pos_ref_torche-0.2;
 ELSE
 	Limite_PLus_Z_Laser := Pnc_axe_Z_Robot.Limite_Plus;
 END_IF
	 
//Interdit Z chariot si pince serrée ou dans machine
 ZChariot_Interdit:= Ev_Serrage_pince OR Detecteur_Fond_De_Pince OR (Pos_Reel_X>= X_Cell_Mesure_Barre-1000); //1000 distance arbitraire, car moteur A present
 
Pos_Parking_ZChariot:= Pnc_axe_Z_Chariot.Limite_Plus-20 ;


//Vitesse X chariot : selection Opanel / A investiguer
 Override_Chariot:=100;
 IF manu THEN
	 IF NOT Gestion_Pince.Pos_Z_Pince_en_Bas THEN 
		 Limite_Plus_X:=X_Cell_Mesure_Barre-1000;
	 ELSE 
		 Limite_Plus_X:=Pnc_axe_Chariot.Limite_Plus;
	 END_IF	 
 END_IF
 IF (Jog_Plus_X OR Ev_Serrage_Pince) AND (Presseur_Amont_K11.Stop_Chariot OR Presseur_Aval_L12.Stop_Chariot) THEN  
	 	Vitesse_Chariot_Auto:= 
		Vitesse_Chariot_Manu:= 0;
		Override_Chariot:=0;
 ELSIF Pos_Reel_X >= X_Cell_Mesure_Barre 
	OR (Ev_Serrage_Pince AND (Pos_Reel_X+Longueur_Barre_en_Pince) >= X_Cell_Mesure_Barre)  THEN
 	Vitesse_Chariot_Auto:=
	Vitesse_Chariot_Manu:=(Vitesse_ES_Machine * Pnc_Modulation_Vitesse)/9;
 ELSIF Manu THEN
 	  Vitesse_Chariot_Manu :=(PNC_Axe_Chariot.Vitesse_MAN*Pnc_Modulation_Vitesse)/9 ;
 END_IF
 
//X Chariot : Determination zone de decel selon accel - investiguer => Calcul accel selon poids corniere
 IF auto AND Accel_Decel_XChariot<>0 THEN 
	 Zone_Decel_XChariot:= (Vitesse_Chariot_Auto*Vitesse_Chariot_Auto) / Accel_Decel_XChariot;	//(mm/s)2 / mm/s-2 => mm 
 END_IF
 
 IF Manu AND Accel_Decel_XChariot<>0 AND Vitesse_Chariot_Manu <>0 THEN
	Zone_Decel_XChariot:= (Vitesse_Chariot_Manu*Vitesse_Chariot_Manu) / Accel_Decel_XChariot;	//(mm/s)2 / mm/s-2 => mm  
 END_IF
 
//Accel_Decel_XChariot;	investiguer, calcul selon poids, voir ce qu a fait hubert
 
 
 
// Pos Y relative a la corniere - Si offset Y Face 1/2/ecr OK seulement !
	Pos_Y_RelaFaceRef:=(Pos_Reel_Y_Laser - Offset_Y_Laser_REF)+Ep_Ame;
	Pos_Y_RelaFaceOppRef:=(Offset_Y_Laser_OPP_REF-Pos_Reel_Y_Laser)+EP_Aile;
	Pos_Y_RelaFaceEcret:= Pos_Reel_Y_Laser-Offset_Y_Laser_ECRETAGE;

//Gestion vitesses Manu Axes 
	IF Selection_DecManu_Laser THEN //Investiguer - vitesse selon recette de decoupe en manu
		Vitesse_Manu_X_Laser := 70;
		Vitesse_Manu_Y_Laser := 70;
	ELSE
		Vitesse_Manu_X_Laser := Pnc_axe_X_Robot.Vitesse_MAN;
		Vitesse_Manu_Y_Laser := Pnc_axe_Y_Robot.Vitesse_MAN;
	END_IF


]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>