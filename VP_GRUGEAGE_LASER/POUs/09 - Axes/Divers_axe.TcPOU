<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Divers_axe" Id="{a6e9f152-aea4-4f9f-9475-5b980e5e3e1c}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Divers_axe
//Gestion override axes et autres
VAR
XYL_Interdit	:BOOL;
ZChariot_Interdit	:BOOL;
//Relevage/abaissement pince
 Pos_Parking_ZChariot	:LREAL;

END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//Fronts, TON, etc
 RE_En_pos_X(clk:=En_pos_X);
 RE_En_pos_Z_Chariot(clk:=En_pos_Z_Chariot);
 RE_En_pos_A_Laser(clk:=En_pos_A_Laser);
 RE_En_pos_X_Laser(clk:=En_pos_X_Laser);
 RE_En_pos_Y_Laser(clk:=En_pos_Y_Laser);
 RE_En_pos_Z_Laser(clk:=En_pos_Z_Laser);

//Interdit XY Laser en Manu si pas découpe et Z trop bas pour ne pas endommager la buse ?
 XYL_Interdit := Manu AND (Offset_Z_Laser_REF-Pos_Reel_Z_Laser < 2* Global_Divers.EP_Aile) AND NOT Selection_DecManu_Laser;
//Limite Z laser 
 IF Prog_Capacitance_Calibration_OK AND G7_Palpage_Capacitance.Init.x THEN
 	Limite_PLus_Z_Laser := pos_ref_torche-0.2;
 ELSE
 	Limite_PLus_Z_Laser := Pnc_axe_Z_Robot.Limite_Plus;
 END_IF
	 
//Interdit Z chariot si pince serrée ou dans machine
 ZChariot_Interdit:= Ev_Serrage_pince OR Detecteur_Fond_De_Pince OR Pos_Reel_X>= X_Cell_Mesure_Barre;

Pos_Parking_ZChariot:= Pnc_axe_Z_Chariot.Limite_Plus-20 ;

Origines_Axes_ok := 
 Ref_Ok_X
 AND Ref_Ok_Z_Chariot
 AND Ref_Ok_X_Laser
 AND Ref_Ok_Y_Laser
 AND Ref_Ok_Z_Laser
 AND Ref_Ok_A_Laser
 ;

//Vitesse X chariot : selection Opanel + override / A investiguer - corriger par vitesse si besoin
 Override_Chariot:=100;
 IF Jog_Plus_X OR Ev_Serrage_Pince AND (Presseur_Amont_K11.Stop_Chariot OR Presseur_Aval_L12.Stop_Chariot) THEN  
	 	Vitesse_Chariot_Auto:= 
		Vitesse_Chariot_Manu:= 
		Override_Chariot:=0;
 ELSIF Pos_Reel_X >= Pos_X_Mesure_Barre THEN
 	Vitesse_Chariot_Auto:=
	Vitesse_Chariot_Manu:=Vitesse_ES_Machine * (Pnc_Modulation_Vitesse/9);
 ELSIF Manu AND Joystick_Bt_Valid THEN
	  Vitesse_Chariot_Manu :=PNC_Axe_Chariot.Vitesse_MAN;
 ELSIF manu THEN
 	  Vitesse_Chariot_Manu :=(PNC_Axe_Chariot.Vitesse_MAN) * (Pnc_Modulation_Vitesse/9) ;
 END_IF
 
// Pos Y relative a la corniere - Si offset Y Face 1/2/ecr OK seulement !
	Pos_Y_RelaFaceRef:=(Pos_Reel_Y_Laser - Offset_Y_Laser_REF)+Ep_Ame;
	Pos_Y_RelaFaceOppRef:=(Offset_Y_Laser_OPP_REF-Pos_Reel_Y_Laser)+EP_Aile;
	Pos_Y_RelaFaceEcret:= Pos_Reel_Y_Laser-Offset_Y_Laser_ECRETAGE;

//Gestion vitesses Manu Axes 
	IF Selection_DecManu_Laser THEN 
		Vitesse_Manu_X_Laser := 50;
		Vitesse_Manu_Y_Laser := 50;
	ELSE
		Vitesse_Manu_X_Laser := Pnc_axe_X_Robot.Vitesse_MAN;
		Vitesse_Manu_Y_Laser := Pnc_axe_Y_Robot.Vitesse_MAN;
	END_IF

(*
(*			calcul live des vals pour palpage sommet						*)

//Si X repère = Y axe et Y repère = Z axe - Avec FxPx
IF F1P1.Y <> 0 AND F1P2.Y <>0 		
	AND F2P1.Y <> 0 AND F2P2.Y <> 0 THEN

	(* Calcul a1 du coefficient Directeur de la Droite Coté Aile REF *)
	IF F1P1.X - F1P2.X<>0 THEN
		a1s := (F1P1.Y - F1P2.Y)/(F1P1.X - F1P2.X);
	END_IF
	//Si cornière parfaite, bien posée sur le bati machine, alors F1P1.Y - F1P2.Y =0. Si c'est le cas, la droite Y1(x)=b1 avec B1 = F1P1.Y ou F1P2.Y qui sont égaux
	(* Calcul de l'Ordonnée à l'Origine b1 de la Droite Coté Aile REF *)
	b1s := F1P1.Y - (a1s *F1P1.X);
	
	(* Calcul a2 du coefficient Directeur de la Droite Coté Aile OPP REF *)
	IF F2P1.X - F2P2.X<>0 THEN
		a2s := (F2P1.Y - F2P2.Y) / (F2P1.X - F2P2.X);
	END_IF
	//Si cornière parfaite, bien posée sur le bati machine, alors F2P1.X - F2P2.X =0. la droite Y2(x)= F2P1.X ou F2P2.X qui sont égaux
	(* Calcul de l'Ordonnée à l'Origine b1 de la Droite Coté Aile REF *)
	b2s := F2P1.Y - (a2s * F2P1.X);
	
	IF a1s-a2s <> 0 THEN
		Y_Sommet_Pour_Aile_OPP_REFs := (b2s - b1s) / (a1s-a2s);
	END_IF
	Y_Sommet_Pour_Aile_REFs := a1s * Y_Sommet_Pour_Aile_OPP_REFs + b1s;

	(* Calcul de l'angle de la Droite 1 Aile REF *)
	Alpha1s := ATAN(a1s);
	(* Calcul de l'angle de la Droite 2 Aile OPP REF *)
	Alpha2s := ATAN(a2s);

END_IF


//Si X repère = Z axe et Y repère = Y axe - Avec FxPxP - inversion X et Y
IF F1P1P.Y <> 0 AND F1P2P.Y <>0 		
	AND F2P1P.Y <> 0 AND F2P2P.Y <> 0 THEN
	(* Calcul a1 du coefficient Directeur de la Droite Coté Aile REF *)
	IF F1P1P.X - F1P2P.X <> 0 THEN
		a1sS := (F1P1P.Y - F1P2P.Y)/(F1P1P.X - F1P2P.X);
	END_IF
	(* Calcul de l'Ordonnée à l'Origine b1 de la Droite Coté Aile REF *)
	b1sS := F1P1P.Y - (a1ss *F1P1P.X);
	
	(* Calcul a2 du coefficient Directeur de la Droite Coté Aile OPP REF *)
	IF F2P1P.X - F2P2P.X <> 0 THEN
		a2sS := (F2P1P.Y - F2P2P.Y) / (F2P1P.X - F2P2P.X);
	END_IF
	(* Calcul de l'Ordonnée à l'Origine b1 de la Droite Coté Aile REF *)
	b2sS := F2P1P.Y - (a2ss * F2P1P.X);
	IF a1ss-a2ss <> 0 THEN
		Y_Sommet_Pour_Aile_OPP_REFss := (b2ss - b1ss) / (a1ss-a2ss);
	END_IF
	Y_Sommet_Pour_Aile_REFss := a1ss * Y_Sommet_Pour_Aile_OPP_REFss + b1ss;

	(* Calcul de l'angle de la Droite 1 Aile REF *)
	Alpha1ss := ATAN(a1ss);
	(* Calcul de l'angle de la Droite 2 Aile OPP REF *)
	Alpha2ss := ATAN(a2ss);

END_IF
	
IF F1Z1 <> 0 AND F1Z2 <>0 
	AND F2Z1 <> 0 AND F2Z2 <> 0 THEN

	(* Calcul a1 du coefficient Directeur de la Droite Coté Aile REF *)
	IF (F1Y1 - F1Y2) <> 0 THEN 
		a1b := (F1Z1 - F1Z2)/(F1Y1 - F1Y2);
	END_IF
	(* Calcul de l'Ordonnée à l'Origine b1 de la Droite Coté Aile REF *)
	b1b := F1Z1 - (a1b * F1Y1 );
	
	
	(* Calcul a2 du coefficient Directeur de la Droite Coté Aile OPP REF *)
	IF F2Y1 - F2Y2 <> 0 THEN
		a2b := (F2Z1 - F2Z2)/(F2Y1 - F2Y2);
	END_IF
	(* Calcul de l'Ordonnée à l'Origine b1 de la Droite Coté Aile REF *)
	b2b := F2Z1 - (a2b * F2Y1);
	
	IF (a1b-a2b)<> 0 THEN
		Y_Sommet_Pour_Aile_OPP_REFb := (b2b - b1b) / (a1b-a2b);
	END_IF
	Y_Sommet_Pour_Aile_REFb := a1b * Y_Sommet_Pour_Aile_OPP_REFb + b1b;

	(* Calcul de l'angle de la Droite 1 Aile REF *)
	Alpha1b := ATAN(a1b);
	(* Calcul de l'angle de la Droite 2 Aile OPP REF *)
	Alpha2b := ATAN(a2b);
	
END_IF;
*)

]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>